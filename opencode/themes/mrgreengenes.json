        "300": "#e2423a",
        "400": "#c24232",
        "500": "#a24229",
        "600": "#804220",
        "700": "#5d4216",
        "800": "#3b420d",
        "900": "#224207"
      },
"orange": {
        "100": "#ffac4c",
        "200": "#ff8800",
        "300": "#e28000",
        "400": "#c27600",
        "500": "#a26d00",
        "600": "#806400",
        "700": "#5d5a00",
        "800": "#3b5000",
        "900": "#224900"
      },
"yellow": {
        "100": "#ffff4c",
        "200": "#ffff00",
        "300": "#e2e800",
        "400": "#c2d000",
        "500": "#a2b700",
        "600": "#809d00",
        "700": "#5d8200",
        "800": "#3b6800",
        "900": "#225500"
      },
"green": {
        "100": "#7de16a",
        "200": "#45d42a",
        "300": "#3ec225",
        "400": "#36b020",
        "500": "#2f9d1a",
        "600": "#268814",
        "700": "#1e740e",
        "800": "#165f08",
        "900": "#105104"
      },
"cyan": {
        "100": "#4cf2f2",
        "200": "#00eded",
        "300": "#01d8d1",
        "400": "#02c2b2",
        "500": "#04ac93",
        "600": "#059472",
        "700": "#077c51",
        "800": "#08642f",
        "900": "#095318"
      },
"blue": {
        "100": "#56b1ff",
        "200": "#0d8fff",
        "300": "#0d86e0",
        "400": "#0c7cbf",
        "500": "#0c729e",
        "600": "#0b677a",
        "700": "#0b5c57",
        "800": "#0b5133",
        "900": "#0a4a1a"
      },
"purple": {
        "100": "#ff8ef6",
        "200": "#ff5ef2",
        "300": "#e25bd5",
        "400": "#c257b6",
        "500": "#a25396",
        "600": "#804f74",
        "700": "#5d4c52",
        "800": "#3b4830",
        "900": "#224518"
      },
      "accent": "$hue.green",
      "interactive": "$hue.orange",
      "neutral": "$hue.gray"
    },
    "diff": {
      "text": {
        "added": "$hue.green.100"
      },
      "background": {
        "added": "#155c08",
        "removed": "#58130a"
      },
      "lineNumber": {
        "background": {
          "added": "#105104",
          "removed": "#430e08"
        }
      }
    }
  }
}